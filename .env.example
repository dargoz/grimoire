# Template for .env — copy to `.env` and fill in real values.
# Used by envied at build time (see lib/core/configuration/env.dart).

# GitLab Personal Access Token used as a default/fallback for API calls.
# Create one at: https://gitlab.com/-/profile/personal_access_tokens
GIT_ACCESS_TOKEN=your_gitlab_token_here

# Typesense server configuration (used by the wiki search feature).
TYPESENSE_URL=https://your-typesense-host
TYPESENSE_API_KEY=your_typesense_api_key_here
